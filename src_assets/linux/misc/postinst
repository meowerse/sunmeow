#!/bin/sh

# Load uhid for descriptor-driven gamepad emulation
echo "Loading uhid kernel module for gamepad emulation."
modprobe uhid

# Homebrew installs host integration files inside its Cellar. Copy them to
# host directories that systemd-udevd and systemd-modules-load monitor.
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# MEOW-TOUCH(rebrand): this block arrived in the c75d5d76 sync and names the files it
# copies. We ship 60-sunmeow.*, so against upstream's names it would find nothing and
# silently install no udev rule -- gamepads would simply not work, with no error.
packaged_udev_rule="$script_dir/../lib/udev/rules.d/60-sunmeow.rules"
packaged_modules_file="$script_dir/../lib/modules-load.d/60-sunmeow.conf"
if [ -f "$packaged_udev_rule" ]; then
  echo "Installing Sunmeow udev rules."
  install -Dm644 "$packaged_udev_rule" /etc/udev/rules.d/60-sunmeow.rules
fi
if [ -f "$packaged_modules_file" ]; then
  echo "Installing Sunmeow modules-load configuration."
  install -Dm644 "$packaged_modules_file" /etc/modules-load.d/60-sunmeow.conf
fi

# Ensure Sunshine can grab images from KMS
path_to_setcap=$(which setcap)
# MEOW-TOUCH(rebrand): resolve OUR binary. `which sunshine` finds the distro package's
# binary on any machine that has it, so this granted cap_sys_admin,cap_sys_nice to another
# package's executable and left ours with none -- which presents as the fork black-screening
# on KMS/Wayland capture, i.e. exactly the symptom the setcap step exists to prevent.
# Upstream's script-relative branch (added for Homebrew, whose binary lives in the Cellar
# and is not on PATH at postinst time) is kept -- only the name it looks for changes.
if [ -x "$script_dir/sunmeow" ]; then
  path_to_sunshine=$(readlink -f "$script_dir/sunmeow")
else
  path_to_sunshine=$(readlink -f "$(which sunmeow)")
fi
if [ -x "$path_to_setcap" ] ; then
  echo "Setting CAP_SYS_ADMIN, CAP_SYS_NICE capabilities on Sunshine binary."
  echo "$path_to_setcap cap_sys_admin,cap_sys_nice+p $path_to_sunshine"
  $path_to_setcap cap_sys_admin,cap_sys_nice+p "$path_to_sunshine"
  echo "CAP_SYS_ADMIN, CAP_SYS_NICE capabilities set on Sunshine binary."
else
  echo "error: setcap not found or not executable."
fi

# Reload the rules and reapply them to both virtual device factories and any
# gamepad child nodes that already exist.
path_to_udevadm=$(which udevadm)
if [ -x "$path_to_udevadm" ] ; then
  echo "Reloading udev rules."
  $path_to_udevadm control --reload-rules
  $path_to_udevadm trigger --property-match=DEVNAME=/dev/uinput
  $path_to_udevadm trigger --property-match=DEVNAME=/dev/uhid
  $path_to_udevadm trigger --subsystem-match=hidraw
  $path_to_udevadm trigger --subsystem-match=input
  echo "Udev rules reloaded successfully."
else
  echo "error: udevadm not found or not executable."
fi
